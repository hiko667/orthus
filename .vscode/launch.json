{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Orthus",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Orthus",
            "args": ["-s", "./zzzzzzzzzz", "-t", "./ccccccccccccc"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build with Makefile",  // <--- DODAJ TĘ LINIĘ
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Śledź proces potomny",
                    "text": "set follow-fork-mode child",
                    "ignoreFailures": false
                },
                {
                    "description": "Nie odłączaj się od potomka",
                    "text": "set detach-on-fork off",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}